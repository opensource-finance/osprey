# Binaries (root-anchored so cmd/benchmark source is never matched)
/osprey
/benchmark
/benchmark-test
*.exe
*.dll
*.so
*.dylib

# Demo recordings (large generated media; regenerate from demos/*.tape)
demos/*.gif
demos/*.mp4

